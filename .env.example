# Copiar a .env y completar. Nunca subir .env a git.

# BD de desarrollo (docker compose). El servicio lee con un usuario de solo lectura.
POSTGRES_DB=ciumb
POSTGRES_USER=ciumb_admin
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Conexión de escritura usada solo por datos_sinteticos.generar (desarrollo).
DATABASE_URL_ADMIN=postgresql+psycopg://ciumb_admin:CAMBIAR@localhost:5432/ciumb

# Conexión de solo lectura del servicio (invariante 3).
DATABASE_URL_LECTURA=postgresql+psycopg://ciumb_lector:CAMBIAR@localhost:5432/ciumb
CONSULTA_LIMITE_FILAS=100000
CONSULTA_TIMEOUT_S=30

# Sal secreta de seudonimización SHA-256 (invariante 5). Obligatoria en el ETL.
SAL_SEUDONIMIZACION=
